# ---------------------------------------------------------------------------
# Bot-by-ai — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real `.env`. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
APP_VERSION=1.0.0

# --- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your-bot-token
# Application (client) id — same developer portal page
DISCORD_CLIENT_ID=000000000000000000
# OAuth2 client secret — needed for the dashboard login. Server-side only.
DISCORD_CLIENT_SECRET=your-oauth2-client-secret
# Must exactly match the redirect added in the developer portal
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Guild used by `npm run deploy:commands` for instant guild-scoped registration
DEV_GUILD_ID=000000000000000000

# --- Bot owners (owner-only features) --------------------------------------
# Comma separated Discord user ids. Both ids have identical privileges.
# Server administrators do NOT get owner powers from Discord permissions.
BOT_OWNER_IDS=1131248987173814336,1473315482554732786

# --- PostgreSQL (required) -------------------------------------------------
DATABASE_URL=postgres://botuser:change-me@localhost:5432/botbyai
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Redis (optional — used for cross-process rate limits/locks) -----------
# Leave empty to run single-process without Redis.
REDIS_URL=

# --- Dashboard -------------------------------------------------------------
ENABLE_DASHBOARD=true
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000
# >= 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-plus-random-characters
SESSION_TTL_HOURS=168

# --- Music (optional; Lavalink required for real audio) --------------------
ENABLE_MUSIC=false
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
# Spotify is used for METADATA ONLY (track/album/playlist titles via the Web
# API). Playing actual Spotify audio requires a Lavalink plugin such as
# LavaSrc plus your own Spotify credentials — see docs/DEPLOYMENT.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Observability ---------------------------------------------------------
METRICS_ENABLED=true
# HTTP port for /healthz, /readyz, /metrics
PORT=8080
